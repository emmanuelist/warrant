{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    // Imports reachable from vite.config.ts name their file (Vite's native config loader resolves no extensions).
    "allowImportingTsExtensions": true,
    // The host transpiles api/ and relay/ file by file with this config; its emitted .js must import .js.
    "rewriteRelativeImportExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src", "relay", "api", "vite.config.ts"]
}
